<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CineForge Desktop Setup</AssemblyName>
    <RootNamespace>CineForge.Installer</RootNamespace>
    <ApplicationIcon>..\assets\CineForge.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <Product>CineForge Desktop</Product>
    <Company>The Bald Dude Co.</Company>
    <Copyright>Copyright 2026 The Bald Dude Co.</Copyright>
  </PropertyGroup>
  <ItemGroup Condition="'$(SkipPayload)' != 'true'">
    <EmbeddedResource Include="..\payload\CineForge-Payload.zip" LogicalName="CineForge.Payload.zip" />
  </ItemGroup>
</Project>
