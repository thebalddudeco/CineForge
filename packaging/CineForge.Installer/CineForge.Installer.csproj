<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CineForge Desktop Setup</AssemblyName>
    <RootNamespace>CineForge.Installer</RootNamespace>
    <ApplicationIcon>..\..\..\..\Brand System\Logos\Exports\favicon\cineforge-app-icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Version>0.5.0</Version>
    <FileVersion>0.5.0.0</FileVersion>
    <Product>CineForge Desktop</Product>
    <Company>The Bald Dude Co.</Company>
    <Copyright>Copyright 2026 The Bald Dude Co.</Copyright>
    <CineForgeRuntimeFileName Condition="'$(CineForgeRuntimeFileName)' == ''">CineForge-Desktop-Runtime-0.5.0-win-x64.zip</CineForgeRuntimeFileName>
    <CineForgeRuntimeUrl Condition="'$(CineForgeRuntimeUrl)' == ''">https://github.com/thebalddudeco/CineForge/releases/download/v0.5.0/CineForge-Desktop-Runtime-0.5.0-win-x64.zip</CineForgeRuntimeUrl>
    <CineForgeRuntimeBytes Condition="'$(CineForgeRuntimeBytes)' == ''">2017201506</CineForgeRuntimeBytes>
    <CineForgeRuntimeSha256 Condition="'$(CineForgeRuntimeSha256)' == ''">4ab5dbfbe10c576aea97276f3e8a554d57fe544d0cf11437cb656cec4794d346</CineForgeRuntimeSha256>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CineForgeRuntimeFileName" Value="$(CineForgeRuntimeFileName)" />
    <AssemblyMetadata Include="CineForgeRuntimeUrl" Value="$(CineForgeRuntimeUrl)" />
    <AssemblyMetadata Include="CineForgeRuntimeBytes" Value="$(CineForgeRuntimeBytes)" />
    <AssemblyMetadata Include="CineForgeRuntimeSha256" Value="$(CineForgeRuntimeSha256)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\Brand System\Fonts\Anta-Regular.ttf" LogicalName="CineForge.Installer.Fonts.Anta-Regular.ttf" />
    <EmbeddedResource Include="..\..\..\..\Brand System\Fonts\SairaCondensed-Regular.ttf" LogicalName="CineForge.Installer.Fonts.SairaCondensed-Regular.ttf" />
    <EmbeddedResource Include="..\..\..\..\Brand System\Fonts\CutiveMono-Regular.ttf" LogicalName="CineForge.Installer.Fonts.CutiveMono-Regular.ttf" />
    <EmbeddedResource Include="..\..\..\..\Brand System\Fonts\InterTight-VariableFont_wght.ttf" LogicalName="CineForge.Installer.Fonts.InterTight-VariableFont_wght.ttf" />
    <EmbeddedResource Include="..\..\..\..\Brand System\Logos\Exports\icon-mark-acid\icon-mark-acid-64.png" LogicalName="CineForge.Installer.Brand.icon-mark-acid-64.png" />
    <EmbeddedResource Include="..\..\..\..\Brand System\System\Generated\version-badge-filled-acid-v0.5.0.png" LogicalName="CineForge.Installer.Brand.version-badge-filled-acid-v0.5.0.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkipPayload)' != 'true'">
    <EmbeddedResource Include="..\payload\CineForge-Payload.zip" LogicalName="CineForge.Payload.zip" />
  </ItemGroup>
</Project>
