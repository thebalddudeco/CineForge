<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CineForge Desktop Setup</AssemblyName>
    <RootNamespace>CineForge.Installer</RootNamespace>
    <ApplicationIcon>..\..\..\..\Brand System\Logos\Exports\favicon\cineforge-app-icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Version>5.1</Version>
    <FileVersion>5.1.0.0</FileVersion>
    <Product>CineForge Desktop</Product>
    <Company>The Bald Dude Co.</Company>
    <Copyright>Copyright 2026 The Bald Dude Co.</Copyright>
    <CineForgeRuntimeFileName Condition="'$(CineForgeRuntimeFileName)' == ''">CineForge-Desktop-Runtime-5.1-win-x64.zip</CineForgeRuntimeFileName>
    <CineForgeRuntimeUrl Condition="'$(CineForgeRuntimeUrl)' == ''">https://github.com/thebalddudeco/CineForge/releases/download/v5.1/CineForge-Desktop-Runtime-5.1-win-x64.zip</CineForgeRuntimeUrl>
    <CineForgeRuntimeBytes Condition="'$(CineForgeRuntimeBytes)' == ''">2092590185</CineForgeRuntimeBytes>
    <CineForgeRuntimeSha256 Condition="'$(CineForgeRuntimeSha256)' == ''">82f3339f91ba6ccbaa4ba6fc4879c0065afd84845c56dbe2a5a369cedb1f4e9a</CineForgeRuntimeSha256>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CineForgeRuntimeFileName" Value="$(CineForgeRuntimeFileName)" />
    <AssemblyMetadata Include="CineForgeRuntimeUrl" Value="$(CineForgeRuntimeUrl)" />
    <AssemblyMetadata Include="CineForgeRuntimeBytes" Value="$(CineForgeRuntimeBytes)" />
    <AssemblyMetadata Include="CineForgeRuntimeSha256" Value="$(CineForgeRuntimeSha256)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\Brand System\Logos\Exports\icon-mark-acid\icon-mark-acid-512.png" LogicalName="CineForge.Brand.icon-mark-acid-512.png" />
    <EmbeddedResource Include="..\..\..\..\Brand System\Logos\Exports\wordmark-alabaster\wordmark-alabaster-512.png" LogicalName="CineForge.Brand.wordmark-alabaster-512.png" />
    <EmbeddedResource Include="..\..\..\..\Brand System\System\Generated\version-badge-filled-acid-v5.1.png" LogicalName="CineForge.Brand.version-badge-filled-acid-v5.1.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkipPayload)' != 'true'">
    <EmbeddedResource Include="..\payload\CineForge-Payload.zip" LogicalName="CineForge.Payload.zip" />
  </ItemGroup>
</Project>
